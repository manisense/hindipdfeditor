{
  "name": "hindi-pdf-editor-website",
  "private": true,
  "scripts": {
    "build:editor": "npm --prefix editor ci --progress=false && npm --prefix editor run build",
    "prepare:publish": "node scripts/prepare-publish.mjs",
    "build": "npm run build:editor",
    "test:routing": "node --test scripts/migration-worker.test.mjs",
    "dev:editor": "npm --prefix editor run dev",
    "deploy": "wrangler pages deploy dist --project-name hindipdfeditor",
    "check:publish": "node scripts/check-publish.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.110.0"
  }
}
