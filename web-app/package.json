{
  "name": "hindi-pdf-editor-website",
  "private": true,
  "scripts": {
    "build:editor": "npm --prefix editor ci --progress=false && npm --prefix editor run build",
    "prepare:publish": "node scripts/prepare-publish.mjs",
    "build": "npm run build:editor",
    "test:routing": "node --test scripts/migration-worker.test.mjs",
    "dev:editor": "npm --prefix editor run dev",
    "deploy": "node scripts/wrangler-project.mjs deploy",
    "check:publish": "node scripts/check-publish.mjs",
    "test:content": "node --test scripts/article-template.test.mjs && node scripts/check-content.mjs",
    "refresh:content": "node scripts/seo-worker.mjs --refresh-published",
    "test:analytics": "node --test scripts/analytics.test.mjs",
    "check:fonts": "node scripts/check-fonts.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.110.0"
  }
}
