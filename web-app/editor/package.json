{
  "name": "hindi-pdf-editor-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run copy:assets && vite",
    "build": "npm run copy:assets && tsc --noEmit && vite build && vite build --ssr src/prerender.tsx --outDir .prerender && node ../scripts/prepare-publish.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0",
    "deploy": "node ../scripts/wrangler-project.mjs deploy",
    "copy:assets": "node scripts/copy-ocr-assets.mjs && node scripts/copy-pdfjs-assets.mjs"
  },
  "dependencies": {
    "@anthro-ai/krutidev-unicode": "0.1.0",
    "@cantoo/pdf-lib": "^2.7.1",
    "@hindipdfeditor/translation-contract": "file:../../packages/translation-contract",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "pdfjs-dist": "^5.3.93",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^6.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/hin": "1.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "canvas": "^3.2.3",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
