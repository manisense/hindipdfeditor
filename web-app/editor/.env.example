# Public Cloudflare Turnstile site key. Never put the Turnstile secret or Gemini key here.
VITE_TURNSTILE_SITE_KEY=replace-with-production-site-key

# Optional public endpoint override for local/staging API testing.
# Production uses https://api.hindipdfeditor.com when this is omitted.
VITE_AI_API_BASE_URL=http://localhost:8787
