# Cloudflare's public always-pass test key for local development only.
# Production gets its real public site key from .env.production.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional public endpoint override for local/staging API testing.
# Production uses https://api.hindipdfeditor.com when this is omitted.
VITE_AI_API_BASE_URL=http://localhost:8787
