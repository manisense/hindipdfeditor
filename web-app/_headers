/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000

# Site assets are not content-hashed (site.css, analytics.js, images), so a
# year-long immutable cache would serve stale files after a deploy.
/assets/*
  Cache-Control: public, max-age=86400, must-revalidate

# Vite bundles are content-hashed: safe to cache forever.
/edit/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed images that Vite copies into /edit/assets. "! Cache-Control" drops
# the immutable header from the rule above instead of appending to it.
/edit/assets/app-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate

/edit/assets/app-preview.png
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate

/edit/assets/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate

/edit/assets/favicon-32.png
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate

/edit/assets/logo-badge.png
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate

/favicon.ico
  Cache-Control: public, max-age=86400, must-revalidate

/edit/favicon.ico
  Cache-Control: public, max-age=86400, must-revalidate
